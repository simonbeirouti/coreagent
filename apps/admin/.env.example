# Core Admin (independent env)
# Copy to core-admin/.env.local and fill values.

# Supabase project URL (shared with app/server)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co

# For any future client-side auth flows
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-publishable-anon-key>

# Required for this admin panel server-side data access
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Optional registry API surface if you want this panel to call /server endpoints
SKILLS_REGISTRY_API_URL=http://127.0.0.1:4010
