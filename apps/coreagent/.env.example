# Frontend (Vite)
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=<your-publishable-key>

# App services (Tauri + shared DB)
SUPABASE_URL=https://<your-project-id>.supabase.co
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# Optional: only required for scripts/seed flows that call Supabase admin APIs directly
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# AI providers
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Feature flags (Tauri backend)
ADAPTATION_AUTO=true
RETRIEVAL_TELEMETRY=true
RETRIEVAL_AUTO_TUNE=true
IDENTITY_TRENDS=true

# Runtime version used by app-side skill compatibility checks
APP_RUNTIME_VERSION=1.0.0

# Tauri registry client
SKILLS_REGISTRY_BASE_URL=http://127.0.0.1:4010
SKILLS_REGISTRY_TIMEOUT_MS=8000

# Required for admin skill authoring actions from CoreAgent UI:
# - upload artifact
# - docker preflight
# - publish/review skill
# Must match apps/server ADMIN_API_TOKEN when ENABLE_ADMIN_API=true.
ADMIN_API_TOKEN=<set-the-same-admin-token-as-server>
