# Runtime runner service
NODE_ENV=development
LOG_LEVEL=info

# Queue backend
REDIS_URL=redis://127.0.0.1:6379
RUNTIME_RUN_QUEUE_NAME=runtime-runs
RUNTIME_RUN_CONCURRENCY=4

# Runtime permission broker (deny-by-default)
RUNTIME_ALLOW_NETWORK=false
RUNTIME_ALLOW_FILESYSTEM=false
RUNTIME_ALLOW_BROWSER=false
RUNTIME_ALLOW_PROCESS=false
# Comma-separated domains, used when network is enabled (example: api.openai.com,example.com)
RUNTIME_NETWORK_DOMAIN_ALLOWLIST=

# Scoped credential broker mapping.
# Format: <credential_scope>=<ENV_VAR>,<credential_scope>=<ENV_VAR>
# Example: openai_api_key=OPENAI_API_KEY,github_token=GITHUB_TOKEN
RUNTIME_CREDENTIAL_SCOPE_MAP=

# Remote Docker mode (used when executionMode=remote)
RUNTIME_ENABLE_REMOTE_DOCKER=true

# Local Docker mode
RUNTIME_ENABLE_LOCAL_DOCKER=false
RUNTIME_LOCAL_DOCKER_IMAGE=node:20-alpine
# Optional per-skill runtime profile image overrides:
# Format: <profile>=<image>,<profile>=<image>
# Canonical language profiles are: node (js/javascript), python (py), rust (rs)
# Example: default=node:20-alpine,node=node:20-alpine,python=python:3.12-alpine,rust=rust:1.83-alpine
RUNTIME_LOCAL_DOCKER_IMAGE_PROFILES="default=node:20-alpine,node=node:20-alpine,python=python:3.12-alpine,rust=rust:1.83-alpine"

RUNTIME_LOCAL_DOCKER_MEMORY_MB=256
RUNTIME_LOCAL_DOCKER_CPU_SHARES=256
RUNTIME_LOCAL_DOCKER_NETWORK_DISABLED=true
RUNTIME_LOCAL_DOCKER_PULL_IF_MISSING=true

# For artifact://sha256/... URIs, runner resolves files from this directory.
RUNTIME_ARTIFACT_STORAGE_DIR=../server/data/artifacts
