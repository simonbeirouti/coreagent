{
  "name": "runner",
  "version": "0.1.0",
  "description": "CoreAgent runtime runner service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "coreagent",
    "runtime",
    "runner"
  ],
  "author": "CoreAgent",
  "license": "ISC",
  "packageManager": "pnpm@10.8.0",
  "dependencies": {
    "bullmq": "^5.69.3",
    "dockerode": "^4.0.9",
    "dotenv": "^17.2.4",
    "ioredis": "^5.9.3",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.3.0",
    "eslint": "^10.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
