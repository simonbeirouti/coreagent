{
  "name": "server",
  "version": "1.0.0",
  "description": "CoreAgent Skills Registry Service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:admin": "ENABLE_ADMIN_API=true tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "seed:open-skills": "node scripts/seed-open-skills.mjs",
    "test": "vitest run",
    "test:routes": "vitest run src/api/routes",
    "test:changed": "vitest related --run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "check": "pnpm check-types && pnpm lint && pnpm test",
    "check:quick": "pnpm check-types && pnpm test:routes",
    "check:ci": "pnpm check && pnpm validate:migrations && pnpm build"
  },
  "keywords": [
    "coreagent",
    "skills",
    "registry"
  ],
  "author": "CoreAgent",
  "license": "ISC",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/compress": "^8.1.0",
    "@fastify/cors": "^11.1.0",
    "bullmq": "^5.69.3",
    "dotenv": "^17.2.4",
    "fastify": "^5.6.1",
    "ioredis": "^5.9.3",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.6",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
