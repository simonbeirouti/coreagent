# Skills Registry Service runtime
HOST=127.0.0.1
PORT=4010
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Artifact storage/scanning
ARTIFACT_STORAGE_DIR=data/artifacts
ARTIFACT_MAX_BYTES=10485760
ENABLE_HEURISTIC_ARTIFACT_SCANNER=false

# Optional app semver for publish-time compatibility checks
APP_RUNTIME_VERSION=1.0.0

# Registry signing (required for publish flow)
SIGNING_SECRET=
SIGNING_KEY_ID=skills-registry-hmac-v1

# Registry JWT auth (Supabase-compatible)
# Recommended: set SUPABASE_URL and let JWKS/issuer resolve automatically.
SUPABASE_URL=https://<your-project-id>.supabase.co
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=authenticated
JWT_REQUIRE_AUTHENTICATED_ROLE=true
JWT_CLOCK_SKEW_SECONDS=30

# Local/test fallback if not using JWKS (HS256)
JWT_SECRET=

# Registry admin API (publish/revoke)
ENABLE_ADMIN_API=false
ADMIN_API_TOKEN=

# Public API rate limiting
PUBLIC_API_RATE_LIMIT_MAX=120
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60

# Runtime queue (BullMQ + Redis)
# Enable this when running queue-backed runtime with apps/runner.
ENABLE_RUNTIME_QUEUE=false
# Use Redis protocol URLs only (redis:// or rediss://). Do not use Upstash REST https URL.
REDIS_URL=redis://127.0.0.1:6379
RUNTIME_RUN_QUEUE_NAME=runtime-runs
RUNTIME_RUN_MAX_ATTEMPTS=3
RUNTIME_RUN_RETRY_BACKOFF_MS=1000
RUNTIME_AUTOSCALE_MIN_REPLICAS=1
RUNTIME_AUTOSCALE_MAX_REPLICAS=20
RUNTIME_AUTOSCALE_TARGET_CONCURRENCY_PER_REPLICA=4
ENABLE_RUNTIME_REDIS_CACHE=true

# Runtime stale-run reaper
RUNTIME_REAPER_ENABLED=true
RUNTIME_REAPER_INTERVAL_SECONDS=30
RUNTIME_REAPER_STALE_AFTER_SECONDS=900
RUNTIME_REAPER_BATCH_LIMIT=200
