{
  "name": "@coreagent/runtime-contracts",
  "version": "0.1.0",
  "description": "Shared runtime API contracts for CoreAgent runtime services.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
