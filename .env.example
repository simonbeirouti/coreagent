# Frontend (Vite)
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=<your-publishable-key>

# Backend / App services
SUPABASE_URL=https://<your-project-id>.supabase.co
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# Optional: only required for scripts/seed flows that call Supabase admin APIs directly
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# AI providers
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Feature flags (Tauri backend)
ADAPTATION_AUTO=true
RETRIEVAL_TELEMETRY=true
RETRIEVAL_AUTO_TUNE=true
IDENTITY_TRENDS=true

# Skills Registry Server runtime
HOST=127.0.0.1
PORT=4010
LOG_LEVEL=info
DATABASE_SSL=false
DATABASE_POOL_MAX=10
ARTIFACT_STORAGE_DIR=server/data/artifacts
ARTIFACT_MAX_BYTES=10485760
ENABLE_HEURISTIC_ARTIFACT_SCANNER=false
APP_RUNTIME_VERSION=1.0.0

# Registry signing (required for publish flow)
SIGNING_SECRET=
SIGNING_KEY_ID=skills-registry-hmac-v1

# Registry JWT auth (Supabase-compatible)
# Recommended: set SUPABASE_URL and let JWKS/issuer resolve automatically.
# Optional override:
JWT_JWKS_URL=
# Optional explicit issuer (defaults from SUPABASE_URL + /auth/v1):
JWT_ISSUER=
JWT_AUDIENCE=authenticated
JWT_REQUIRE_AUTHENTICATED_ROLE=true
JWT_CLOCK_SKEW_SECONDS=30

# Local/test fallback if not using JWKS (HS256)
JWT_SECRET=

# Registry admin API (publish/revoke)
ENABLE_ADMIN_API=false
ADMIN_API_TOKEN=
