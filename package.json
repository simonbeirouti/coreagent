{
  "name": "coreagent-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:coreagent": "pnpm --filter=coreagent tauri dev",
    "dev:runtime": "turbo run dev --filter=server --filter=runner",
    "dev:admin": "turbo run dev --filter=admin --filter=server",
    "lockfile:all": "pnpm lockfile:coreagent && pnpm lockfile:admin && pnpm lockfile:server && pnpm lockfile:runner && pnpm lockfile:runtime-contracts",
    "lockfile:coreagent": "pnpm --dir apps/coreagent install --lockfile-only --ignore-workspace",
    "lockfile:admin": "pnpm --dir apps/admin install --lockfile-only --ignore-workspace",
    "lockfile:server": "pnpm --dir apps/server install --lockfile-only --ignore-workspace",
    "lockfile:runner": "pnpm --dir apps/runner install --lockfile-only --ignore-workspace",
    "lockfile:runtime-contracts": "pnpm --dir packages/runtime-contracts install --lockfile-only --ignore-workspace",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean": "pnpm clean:turbo && pnpm clean:node_modules",
    "clean:turbo": "rm -rf ./node_modules/.cache/.turbo",
    "clean:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.10",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20"
  }
}
