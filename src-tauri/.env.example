# Database connection (replace with your Supabase PostgreSQL URL)
DATABASE_URL=postgresql://postgres:<password-for-db>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# OpenAI API Key (for agent interactions)
OPENAI_API_KEY=sk-proj-...

# Anthropic API Key (alternative LLM provider)
ANTHROPIC_API_KEY=sk-ant...

# Supabase URL
SUPABASE_URL=https://<your-supabase-url>.supabase.co

# Phase 2 feature flags (set to false to disable a subsystem)
ADAPTATION_AUTO=true
RETRIEVAL_TELEMETRY=true
IDENTITY_TRENDS=true
RETRIEVAL_AUTO_TUNING=true